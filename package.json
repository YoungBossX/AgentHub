{
  "name": "agenthub",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel dev",
    "dev:web": "pnpm --filter @agenthub/web dev",
    "dev:api": "bash scripts/dev-api.sh",
    "check": "pnpm check:web && pnpm check:api && pnpm check:demo && pnpm check:demo-api",
    "check:web": "pnpm --filter @agenthub/web check",
    "check:api": "bash scripts/check-api.sh",
    "check:demo": "pnpm --filter @agenthub/demo check",
    "check:demo-api": "bash scripts/check-demo-api.sh",
    "test": "pnpm test:web && pnpm test:api && pnpm demo:api:test",
    "test:web": "pnpm --filter @agenthub/web test",
    "test:api": "bash scripts/test-api.sh",
    "db:init": "bash scripts/init-db.sh",
    "db:seed": "bash scripts/seed-db.sh",
    "demo:reset": "bash scripts/demo-reset.sh",
    "demo:setup": "pnpm --filter @agenthub/demo install",
    "demo:dev": "pnpm --filter @agenthub/demo dev --host 127.0.0.1 --port ${AGENTHUB_DEMO_PORT:-5173}",
    "demo:api:dev": "bash scripts/dev-demo-api.sh",
    "demo:api:test": "bash scripts/test-demo-api.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "brace-expansion@5.0.6": "5.0.9",
      "browserslist@<=4.28.6": "4.28.7",
      "dompurify": "3.4.13",
      "nanoid@3.3.12": "3.3.18",
      "postcss@8.5.14": "8.5.26",
      "vite@8.0.12": "8.0.16"
    }
  }
}
